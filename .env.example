# EDUGENIUS AI - Environment Configuration
# This project runs 100% OFFLINE without any paid Gemini or AI Studio API keys.

# Server Port (default: 3000)
PORT=3000

# Environment mode ('development' or 'production')
NODE_ENV=development

# (Optional) Local LLM Integration (e.g., Ollama / LocalAI / LM Studio)
# If you run Ollama locally (e.g. `ollama run llama3`), you can specify the URL below.
# If omitted or offline, the built-in NCERT AI tutor engine handles all requests offline!
# LOCAL_LLM_URL=http://localhost:11434
# LOCAL_LLM_MODEL=llama3
